<!-- Stormshield SNS (SN series) - WELF syslog decoders (field=value). -->
<!-- The log TYPE is carried by the logtype="..." field (filter / auth / alarm), NOT by
     id=: every syslog line is emitted with a constant id=firewall (when present at all),
     so dispatch is done on logtype=. Field names follow the SNS v4 "Description of audit
     logs" technical note and real captures (Sekoia/Elastic integrations). Wazuh 4.x. -->

<!-- ===== Filtering (logtype="filter") ===== -->
<decoder name="stormshield">
  <prematch>logtype="filter"</prematch>
</decoder>
<decoder name="stormshield-fw">
  <parent>stormshield</parent>
  <!-- srcport/dstport are optional: non-TCP/UDP traffic (ICMP) has no ports, and a
       required port would drop the whole line. action is required so only pass/block
       events (the ones the rules act on) are decoded here. -->
  <regex type="pcre2">\bproto=(\S+).*?\bsrc=(\S+)(?:\s+srcport=(\d+))?.*?\bdst=(\S+)(?:\s+dstport=(\d+))?.*?\baction=(\w+)</regex>
  <order>protocol,srcip,srcport,dstip,dstport,action</order>
</decoder>

<!-- ===== Authentication (logtype="auth") ===== -->
<!-- The src= and user= fields appear in EITHER order depending on the event, so two
     field decoders are provided under the same parent name; Wazuh uses the first that
     matches. Both feed the same field names, so the rules (decoded_as stormshield-auth)
     are order-agnostic. -->
<decoder name="stormshield-auth">
  <prematch>logtype="auth"</prematch>
</decoder>
<decoder name="stormshield-auth">
  <parent>stormshield-auth</parent>
  <regex type="pcre2">\bsrc=(\S+).*?\buser="([^"]*)".*?\bmsg="([^"]*)"</regex>
  <order>srcip,dstuser,ss_msg</order>
</decoder>
<decoder name="stormshield-auth">
  <parent>stormshield-auth</parent>
  <regex type="pcre2">\buser="([^"]*)".*?\bsrc=(\S+).*?\bmsg="([^"]*)"</regex>
  <order>dstuser,srcip,ss_msg</order>
</decoder>

<!-- ===== IPS alarm (logtype="alarm") ===== -->
<decoder name="stormshield-alarm">
  <prematch>logtype="alarm"</prematch>
</decoder>
<!-- Field ORDER is not stable inside an alarm line: real SNS lines put the alarm
     header (class/alarmid/risk/target) either after the network fields or before
     them, and system alarms carry no network fields at all. A single ordered regex
     therefore decoded nothing on two of the three real alarm lines replayed on
     2026-09-08. As for stormshield-auth, the cases are covered by sibling field
     decoders under the same parent: Wazuh tries them in order and keeps the first
     that matches, so the field names (and the rules) stay order-agnostic. -->
<decoder name="stormshield-alarm">
  <parent>stormshield-alarm</parent>
  <!-- 1. Network alarm, alarm header last: src/dst/[action]/alarmid.
       action is optional so a detect-only (non-blocking) alarm still decodes. -->
  <regex type="pcre2">\bsrc=(\S+).*?\bdst=(\S+)(?:.*?\baction=(\w+))?.*?\balarmid=(\d+)</regex>
  <order>srcip,dstip,action,ss_alarmid</order>
</decoder>
<decoder name="stormshield-alarm">
  <parent>stormshield-alarm</parent>
  <!-- 2. Network alarm, alarm header first: alarmid then src/dst/[action]. Without
       this the action was lost, so a BLOCKING alarm never reached rule 100321. -->
  <regex type="pcre2">\balarmid=(\d+).*?\bsrc=(\S+).*?\bdst=(\S+)(?:.*?\baction=(\w+))?</regex>
  <order>ss_alarmid,srcip,dstip,action</order>
</decoder>
<decoder name="stormshield-alarm">
  <parent>stormshield-alarm</parent>
  <!-- 3. System alarm (class=system: expired certificate, session timeout, CRL
       download failure): no src/dst at all. Last sibling, so it only catches what
       the two above rejected; it decodes the alarm id instead of nothing. -->
  <regex type="pcre2">\balarmid=(\d+)</regex>
  <order>ss_alarmid</order>
</decoder>

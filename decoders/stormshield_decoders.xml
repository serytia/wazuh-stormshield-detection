<!-- Stormshield SNS (SN series) - WELF log decoders (field=value) -->
<!-- The id= field = log type: firewall (filtering), auth (authentication), alarm (IPS)... -->
<!-- Wazuh 4.x compatible. Formats based on the "Audit logs description" documentation. -->

<!-- ===== Filtering (id=firewall) ===== -->
<decoder name="stormshield">
  <prematch>id=firewall </prematch>
</decoder>
<decoder name="stormshield-fw">
  <parent>stormshield</parent>
  <regex type="pcre2">\bproto=(\S+).*?\bsrc=(\S+)\s+srcport=(\d+).*?\bdst=(\S+)\s+dstport=(\d+).*?\baction=(\w+)</regex>
  <order>protocol,srcip,srcport,dstip,dstport,action</order>
</decoder>

<!-- ===== Authentication (id=auth) ===== -->
<decoder name="stormshield-auth">
  <prematch>id=auth </prematch>
</decoder>
<decoder name="stormshield-auth-f">
  <parent>stormshield-auth</parent>
  <regex type="pcre2">\bsrc=(\S+).*?\buser="([^"]*)".*?\bmsg="([^"]*)"</regex>
  <order>srcip,dstuser,ss_msg</order>
</decoder>

<!-- ===== IPS alarm (id=alarm) ===== -->
<decoder name="stormshield-alarm">
  <prematch>id=alarm </prematch>
</decoder>
<decoder name="stormshield-alarm-f">
  <parent>stormshield-alarm</parent>
  <regex type="pcre2">\bsrc=(\S+).*?\bdst=(\S+).*?\baction=(\w+).*?\balarmid=(\d+)</regex>
  <order>srcip,dstip,action,ss_alarmid</order>
</decoder>

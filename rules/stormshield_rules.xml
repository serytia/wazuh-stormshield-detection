<!-- Stormshield SNS - regles de detection (plage locale 100300+) -->

<group name="stormshield,">

  <!-- ===== Filtrage ===== -->
  <rule id="100300" level="0">
    <decoded_as>stormshield</decoded_as>
    <description>Stormshield SNS: evenement firewall groupe.</description>
  </rule>

  <rule id="100301" level="4">
    <if_sid>100300</if_sid>
    <action>block</action>
    <description>Stormshield: connexion BLOQUEE $(srcip):$(srcport) -> $(dstip):$(dstport) ($(protocol))</description>
    <group>firewall_drop,</group>
  </rule>

  <rule id="100302" level="0">
    <if_sid>100300</if_sid>
    <action>pass</action>
    <description>Stormshield: connexion autorisee $(srcip) -> $(dstip):$(dstport) ($(protocol))</description>
    <group>firewall_pass,</group>
  </rule>

  <rule id="100303" level="10" frequency="10" timeframe="60">
    <if_matched_sid>100301</if_matched_sid>
    <same_source_ip />
    <description>Stormshield: nombreux blocages depuis $(srcip) - possible scan/attaque</description>
    <mitre><id>T1046</id></mitre>
    <group>firewall_scan,</group>
  </rule>

  <!-- ===== Authentification ===== -->
  <rule id="100309" level="0">
    <decoded_as>stormshield-auth</decoded_as>
    <description>Stormshield SNS: log authentification groupe.</description>
  </rule>

  <rule id="100310" level="5">
    <if_sid>100309</if_sid>
    <field name="ss_msg" type="pcre2">(?i)(fail|denied|refused|invalid)</field>
    <description>Stormshield: echec d'authentification src $(srcip) user $(dstuser) - $(ss_msg)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100311" level="10" frequency="6" timeframe="120">
    <if_matched_sid>100310</if_matched_sid>
    <same_source_ip />
    <description>Stormshield: brute-force authentification depuis $(srcip)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- ===== Alarme IPS ===== -->
  <rule id="100320" level="6">
    <decoded_as>stormshield-alarm</decoded_as>
    <description>Stormshield: alarme IPS (alarmid $(ss_alarmid)) src $(srcip) -> $(dstip) [$(action)]</description>
    <group>ids,</group>
  </rule>

  <rule id="100321" level="9">
    <if_sid>100320</if_sid>
    <action>block</action>
    <description>Stormshield: alarme IPS BLOQUANTE (alarmid $(ss_alarmid)) src $(srcip) -> $(dstip)</description>
    <mitre><id>T1046</id></mitre>
    <group>ids,</group>
  </rule>

</group>

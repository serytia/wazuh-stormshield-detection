<!-- Stormshield SNS - detection rules (local range 100300+) -->

<group name="stormshield,">

  <!-- ===== Filtering ===== -->
  <rule id="100300" level="0">
    <decoded_as>stormshield</decoded_as>
    <description>Stormshield SNS: firewall event - grouped.</description>
  </rule>

  <rule id="100301" level="4">
    <if_sid>100300</if_sid>
    <action>block</action>
    <description>Stormshield: connection BLOCKED $(srcip):$(srcport) -> $(dstip):$(dstport) ($(protocol))</description>
    <group>firewall_drop,</group>
  </rule>

  <rule id="100302" level="0">
    <if_sid>100300</if_sid>
    <action>pass</action>
    <description>Stormshield: connection allowed $(srcip) -> $(dstip):$(dstport) ($(protocol))</description>
    <group>firewall_pass,</group>
  </rule>

  <rule id="100303" level="10" frequency="10" timeframe="60">
    <if_matched_sid>100301</if_matched_sid>
    <same_source_ip />
    <description>Stormshield: many blocks from $(srcip) - possible scan/attack</description>
    <mitre><id>T1046</id></mitre>
    <group>firewall_scan,</group>
  </rule>

  <!-- ===== Authentication ===== -->
  <rule id="100309" level="0">
    <decoded_as>stormshield-auth</decoded_as>
    <description>Stormshield SNS: authentication log - grouped.</description>
  </rule>

  <rule id="100310" level="5">
    <if_sid>100309</if_sid>
    <field name="ss_msg" type="pcre2">(?i)(fail|denied|refused|invalid)</field>
    <description>Stormshield: authentication failure src $(srcip) user $(dstuser) - $(ss_msg)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100311" level="10" frequency="6" timeframe="120">
    <if_matched_sid>100310</if_matched_sid>
    <same_source_ip />
    <description>Stormshield: authentication brute-force from $(srcip)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- ===== IPS alarm ===== -->
  <rule id="100320" level="6">
    <decoded_as>stormshield-alarm</decoded_as>
    <description>Stormshield: IPS alarm (alarmid $(ss_alarmid)) src $(srcip) -> $(dstip) [$(action)]</description>
    <group>ids,</group>
  </rule>

  <rule id="100321" level="9">
    <if_sid>100320</if_sid>
    <action>block</action>
    <description>Stormshield: BLOCKING IPS alarm (alarmid $(ss_alarmid)) src $(srcip) -> $(dstip)</description>
    <!-- A blocking IPS alarm covers exploitation attempts (injections, protocol abuse,
         known-CVE traffic), which map to Exploit Public-Facing Application. T1046
         (Network Service Discovery) is scanning/recon and belongs on the many-blocks
         rule 100303, not here. -->
    <mitre><id>T1190</id></mitre>
    <group>ids,</group>
  </rule>

</group>
